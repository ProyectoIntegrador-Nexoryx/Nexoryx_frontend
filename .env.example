# VITE_* variables are bundled into the browser: never put private secrets here.
VITE_API_URL=http://localhost:3000/api/v1
VITE_REALTIME_URL=http://localhost:3001

# Firebase web app config (public): Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=

# WebRTC STUN/TURN servers (TS-03): JSON array of RTCIceServer, in one line and single quotes.
# Empty = Google's public STUN only, which usually fails between different networks: add a TURN server.
# TURN credentials go only in .env, Vercel or the Docker build, never in Git.
# VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn-host:3478","username":"user","credential":"secret"}]'
VITE_ICE_SERVERS=
